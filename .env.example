# 배포 주소 (RSS, sitemap, OG 의 절대 URL 에 사용). 끝에 / 없이.
# Vercel 에서는 비워 두면 프로덕션 도메인을 자동으로 사용한다. 커스텀 도메인을 연결하면 그 주소를 넣는다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# giscus (https://giscus.app/ko 에서 생성). 공개 값이라 커밋해도 안전하다.
NEXT_PUBLIC_GISCUS_REPO=hee-hue/blog
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Supabase (Project Settings > API). anon/publishable 키만 사용한다.
# service_role 키는 이 프로젝트에서 쓰지 않으며 절대 커밋하지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
